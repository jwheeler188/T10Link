                        <parameter_list>
                            <parameter parameter_data_type="character" action_argument="Temperature"/>
                        </parameter_list>
                    </command>
                </command_interface>
            </action>
            <action name="SetCoolSetpoint">
                <action_argument name="Temperature" note="In the thermostat's units (T_UNITS)"/>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SETCOOL </command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" action_argument="Temperature"/>
                        </parameter_list>
                    </command>
                </command_interface>
            </action>
            <!-- Auto mode only. -->
            <action name="SetRange">
                <action_argument name="Heat" note="Heat setpoint"/>
                <action_argument name="Cool" note="Cool setpoint"/>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SETRANGE </command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" action_argument="Heat"/>
                            <parameter parameter_data_type="character">,</parameter>
                            <parameter parameter_data_type="character" action_argument="Cool"/>
                        </parameter_list>
                    </command>
                </command_interface>
            </action>
            <!-- Forget setpoints saved for another mode. -->
            <action name="ClearSavedSetpoints">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">CLEARSAVED</command_string>
                    </command>
                </command_interface>
            </action>
            <!-- Clears the filter 1 reminder on the thermostat. -->
            <action name="ResetFilter1">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">RESETFILTER 1</command_string>
                    </command>
                </command_interface>
            </action>
            <action name="ResetFilter2">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">RESETFILTER 2</command_string>
                    </command>
                </command_interface>
            </action>
        </custom_component_actions>
