        <custom_component_actions>
            <!-- Resend every state (also sent at startup). -->
            <action name="RequestAllStates">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">DUMP</command_string>
                    </command>
                </command_interface>
                <execute_on_schedule period_ms="0"></execute_on_schedule>
            </action>
            <!-- Read every value from the thermostat now. -->
            <action name="RefreshThermostat">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">REFRESH</command_string>
                    </command>
                </command_interface>
            </action>
            <!-- Keepalive every minute; the bridge answers PONG. -->
            <action name="Ping">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">PING</command_string>
                    </command>
                </command_interface>
                <execute_on_schedule period_ms="60000"></execute_on_schedule>
            </action>
            <action name="SetMode">
                <action_argument name="Mode" note="OFF, HEAT, COOL or AUTO"/>
                <command_interface interface="ip">
                    <command response_required="no">
