                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SETHEAT </command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" action_argument="HeatPointTemperature"/>
                        </parameter_list>
